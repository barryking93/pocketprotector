# templates/puppet/server/r10k.yaml.erb
# <%= scope().call_function('lookup',['pocketprotector::managed']) %>
#

# The location to use for storing cached Git repos
:cachedir: '/var/cache/r10k'

# A list of git repositories to create
:sources:
  # This will clone the git repository and instantiate an environment per
  # branch in <%= scope().call_function('lookup',['pocketprotector::puppet::prefix::cfg']) %>/code/environments
  :my-org:
    remote: '<%= scope().call_function('lookup',['pocketprotector::puppet::server::git::url']) %>'
    basedir: '<%= scope().call_function('lookup',['pocketprotector::puppet::prefix::code']) %>/environments'
