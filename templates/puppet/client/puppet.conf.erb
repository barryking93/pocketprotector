# templates/puppet/client/puppet.conf.erb
# <%= scope().call_function('lookup',['pocketprotector::managed']) %>
#

<% if @facts['networking']['fqdn'] == scope().call_function('lookup',['pocketprotector::puppet::server']) or @facts['networking']['fqdn'] == scope().call_function('lookup',['pocketprotector::puppet::server::altname']) -%>
[server]
  vardir = <%= scope().call_function('lookup',['+pocketprotector::puppet::server::vardir']) %>
  logdir = <%= scope().call_function('lookup',['+pocketprotector::puppet::server::logdir']) %>
  rundir = <%= scope().call_function('lookup',['+pocketprotector::puppet::server::rundir']) %>
  pidfile = <%= scope().call_function('lookup',['+pocketprotector::puppet::server::pidfile']) %>
  codedir = <%= scope().call_function('lookup',['pocketprotector::puppet::prefix::code']) %>

  # PuppetDB
  storeconfigs = true
  storeconfigs_backend = puppetdb
  report = true
  reports = puppetdb

<% end -%>
[main]
  # environment, aka git branch
  environment = <%= scope().call_function('lookup',['pocketprotector::puppet::git::branch']) %>

<% if @facts['networking']['fqdn'] == scope().call_function('lookup',['pocketprotector::puppet::server']) or @facts['networking']['fqdn'] == scope().call_function('lookup',['pocketprotector::puppet::server::altname']) -%>
  # alternate DNS names
  dns_alt_names = <%= scope().call_function('lookup',['pocketprotector::puppet::server']) %>,IP:127.0.0.1
<% end -%>

[agent]
  server =  <%= scope().call_function('lookup',['pocketprotector::puppet::server']) %>
  number_of_facts_soft_limit = 4096
